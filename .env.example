# --- Database: PostgreSQL --------------------------------------------------
# MUST point at the SAME database the Flash Cup API uses.
# App/runtime queries (Neon: the POOLED "-pooler" connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# Used only if a Prisma command here runs migrations (normally the API repo
# owns migrations). Neon: the UNPOOLED string. Elsewhere: same as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# "production" => plain JSON logs (pino). Anything else => pretty dev logs.
NODE_ENV="production"
