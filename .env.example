# --- Database ------------------------------------------------------------
# MUST be the SAME database the Flash Cup API (flashcup-backend) uses.
# The Prisma schema is shared (vendor/flashleague/.../prisma/schema.prisma):
#   url       = env("DATABASE_URL")
#   directUrl = env("DIRECT_URL")
#
# On Neon there are two connection strings:
#   - POOLED   — host contains "-pooler" (PgBouncer). Use it for DATABASE_URL.
#                Append `pgbouncer=true` so Prisma skips prepared statements.
#   - UNPOOLED — same host without "-pooler". Use it for DIRECT_URL.
#
# This process runs NO migrations (the backend owns them), so DIRECT_URL is
# effectively unused at runtime — but the shared schema references it, so set
# it anyway (unpooled string, or just the same value as DATABASE_URL).

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# "production" => plain JSON logs (pino). Anything else => pretty dev logs.
NODE_ENV="production"
