# --- Database: PostgreSQL (Neon) ---
# App/runtime queries — Neon's POOLED connection string ("-pooler" in the host).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
# Schema migrations only (`prisma migrate deploy`/`migrate dev`) — Neon's
# UNPOOLED connection string (same host, without "-pooler"). Required: running
# migrations through the pooler is unreliable. https://neon.tech/docs/guides/prisma
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Only for the one-time SQLite -> Postgres data copy:
# SQLITE_DATABASE_URL="file:./dev.db"

JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=4001

# Comma-separated list of origins allowed to call this API (CORS). No
# trailing slashes. Include your deployed frontend origin(s).
CORS_ORIGINS="https://flashcup.live,http://localhost:5173"

# Admin account seeded by prisma/seed.js — CHANGE both before deploying
# anywhere real; never commit the actual values you use.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# --- Social sign-in (Google / Facebook) ---
# Google: OAuth 2.0 Client ID of type "Web application" from
#   https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
# Facebook: App ID + App Secret of a "Facebook Login" app from
#   https://developers.facebook.com/apps
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# --- Email verification (SMTP for outgoing mail via Nodemailer) ---
# Works with any provider: Gmail, Resend, SendGrid, Mailgun, Brevo, Amazon SES…
# Leave blank in development — the 6-digit code is printed to the server console
# (and returned as `devCode` in the API response) instead of being emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"          # "true" for port 465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Flash Cup <no-reply@yourdomain.com>"
# Optional tuning:
EMAIL_CODE_TTL_MIN="15"
EMAIL_RESEND_COOLDOWN_SEC="60"
EMAIL_MAX_ATTEMPTS="5"
PASSWORD_RESET_TTL_MIN="15"
PASSWORD_RESET_COOLDOWN_SEC="60"
PASSWORD_RESET_MAX_ATTEMPTS="5"

# --- Payments (Stripe) ---
# Secret key from https://dashboard.stripe.com/apikeys (test mode while
# developing). In production, use a live-mode Restricted Key scoped to just
# Checkout Sessions + Webhook Endpoints instead of the full secret key.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Signing secret for the /api/stripe/webhook endpoint. In dev, run
# `stripe listen --forward-to localhost:4001/api/stripe/webhook` and copy the
# "whsec_..." value it prints. In production, create a webhook endpoint at
# https://dashboard.stripe.com/webhooks pointed at
# https://<your-domain>/api/stripe/webhook and copy its signing secret.
STRIPE_WEBHOOK_SECRET=""
# Origin the player's browser is served from — used to build the Checkout
# success/cancel redirect URLs.
APP_URL="http://localhost:5173"
