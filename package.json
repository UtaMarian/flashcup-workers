{
  "name": "flashcup-workers",
  "version": "1.0.0",
  "description": "Background cron jobs for Flash Cup (match simulation, energy regen, manager polls, events)",
  "main": "src/worker.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/worker.js",
    "prisma:generate": "prisma generate --schema vendor/flashleague/flashleague-backend/prisma/schema.prisma",
    "postinstall": "npm run prisma:generate"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "pino": "^10.3.1",
    "prisma": "^5.18.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3"
  }
}
